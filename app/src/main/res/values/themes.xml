<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BerryForge" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/berry_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- windowLayoutInDisplayCutoutMode is API 27+, so it lives in values-v27/themes.xml
             rather than here: putting it in the base theme would trip the NewApi lint check
             on the minSdk-26 build and be ignored on a strict OEM. -->
    </style>
</resources>
