<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS everywhere by default, with a narrow cleartext exception for private
  networks.

  A self-hosted OpenAI-compatible endpoint (llama.cpp, Ollama, LM Studio) is
  normally plain HTTP on the user's own LAN, and without an exception the app
  cannot talk to one at all. Only private ranges, loopback and the emulator host
  are exempted; everything else, including the public internet and the MCP
  tunnel, still requires TLS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 10.0.2.2 is the host machine as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
    </domain-config>
</network-security-config>
